# Copy this file to .env and replace the placeholders.
# .env is ignored by Git and must never be committed.
JELLYFIN_URL=http://MEDIA_SERVER_HOST:8096
JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
JELLYFIN_USER_ID=REPLACE_WITH_JELLYFIN_USER_ID

# Keep true for normal HTTPS certificates. Set false only for a trusted local
# Jellyfin server using a self-signed HTTPS certificate.
JELLYFIN_VERIFY_SSL=true
